generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model bill {
  id            Int       @id @default(autoincrement())
  description   String?
  amountCents BigInt
  category      String?   @db.VarChar(50)
  date          DateTime? @db.Date
  registered_by Int
  receiptUrl String?
  jornadaId     Int?
  jornada       jornada?  @relation(fields: [jornadaId], references: [id])
  // How the expense was paid; decides whether it leaves the cash drawer.
  payment_method PaymentMethod

  users         users     @relation(fields: [registered_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([jornadaId])
}

model customer {
  id              Int       @id @default(autoincrement())
  customerName    String?   @db.VarChar(100)
  phone           String?   @db.VarChar(20)
  alias           String?   @db.VarChar(30)
  lastConsumption DateTime? @db.Date
  currentBalanceCents BigInt
  registeredDate  DateTime? @db.Date
  debtors         debtors[]
  sales           sales[]
}

model debtors {
  id         Int        @id @default(autoincrement())
  saleID     Int        @unique
  customerID Int
  amountCents BigInt
  status     SaleStatus @default(UNPAID)
  customer   customer   @relation(fields: [customerID], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sales      sales      @relation(fields: [saleID], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Moment the sale was turned into a debt (not the sale's own creation time).
  createdAt        DateTime  @default(now()) @db.Timestamp(6)
  // Jornada where the debt was granted.
  createdJornadaId Int
  createdJornada   jornada   @relation("DebtCreatedJornada", fields: [createdJornadaId], references: [id])

  // Collection data, filled together by payAccount. Null while the debt is open.
  paidAt          DateTime? @db.Timestamp(6)
  paidJornadaId   Int?
  paidJornada     jornada?  @relation("DebtPaidJornada", fields: [paidJornadaId], references: [id])
  // Employee who received the money (not the customer who paid).
  collectedBy     Int?
  collectedByUser users?    @relation("CollectedDebts", fields: [collectedBy], references: [id])

  @@index([customerID, status])
  @@index([createdJornadaId])
  @@index([paidJornadaId])
}

model products {
  id         Int          @id @unique @default(autoincrement())
  name       String?      @unique @db.VarChar(40)
  priceCents BigInt
  active     Boolean      @default(true)
  recipes    recipes[]
  sale_items sale_items[]
}

model recipes {
  productID    Int
  supplyID     Int
  quantityUsedMilliunits BigInt?
  products     products @relation(fields: [productID], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplies     supplies @relation(fields: [supplyID], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([productID, supplyID])
}

model salary {
  id      Int       @id @default(autoincrement())
  userID  Int
  amountCents BigInt
  payDate DateTime? @db.Date
  period  String?   @db.VarChar(65)
  users   users     @relation(fields: [userID], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Jornada open when the payment was made and how it was paid.
  jornadaId      Int
  jornada        jornada       @relation(fields: [jornadaId], references: [id])
  payment_method PaymentMethod

  @@index([jornadaId])
}

model sale_items {
  id                  Int                      @id @default(autoincrement())
  saleID              Int
  productID           Int
  quantity            Int
  unitPriceCents      BigInt
  subtotalCents       BigInt
  consumptionRecorded Boolean                  @default(false)
  products            products                 @relation(fields: [productID], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sales               sales                    @relation(fields: [saleID], references: [id], onDelete: NoAction, onUpdate: NoAction)
  consumptions        sale_item_consumptions[]

  @@index([saleID])
  @@index([productID])
}

model sale_item_consumptions {
  saleItemID             Int
  supplyID               Int
  quantityUsedMilliunits BigInt
  sale_items             sale_items @relation(fields: [saleItemID], references: [id], onDelete: Cascade, onUpdate: NoAction)
  supplies               supplies   @relation(fields: [supplyID], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([saleItemID, supplyID])
  @@index([supplyID])
}

model sales {
  id             Int          @id @default(autoincrement())
  totalCents BigInt?
  source_type    String?      @db.VarChar(30)
  ticketAccountId String?     @db.Uuid
  customerID     Int?
  placedBy       Int
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  status         SaleStatus   @default(UNPAID)
  // Set only while PAID; UNPAID, DEBT and CANCELLED sales have no method.
  payment_method PaymentMethod?
  debtors        debtors?
  sale_items     sale_items[]
  customer       customer?    @relation(fields: [customerID], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users          users        @relation(fields: [placedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  jornadaId      Int?
  jornada        jornada?     @relation(fields: [jornadaId], references: [id])
  // Actual collection attribution; placedBy remains the original order taker.
  paidAt         DateTime?    @db.Timestamp(6)
  paidJornadaId  Int?
  paidJornada    jornada?     @relation("SalePaidJornada", fields: [paidJornadaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  collectedBy    Int?
  collectedByUser users?      @relation("CollectedSales", fields: [collectedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([jornadaId])
  @@index([paidJornadaId])
  @@index([customerID, createdAt])
}

model supplies {
  id                     Int                      @id @default(autoincrement())
  name                   String?                  @db.VarChar(40)
  measureUnit            String?                  @db.VarChar(30)
  currentStockMilliunits BigInt
  unitCostCents          BigInt                   @default(0)
  recipes                recipes[]
  saleItemConsumptions   sale_item_consumptions[]
  active                 Boolean                  @default(true)
}

model users {
  id       Int      @id @default(autoincrement())
  email    String?  @unique @db.VarChar(150)
  name     String?  @db.VarChar(50)
  username String?  @unique @db.VarChar(50)
  pin      String?  @db.VarChar(255)
  pinLookupHash String? @unique @db.VarChar(64)
  password String?  @db.VarChar(255)
  role     String?  @db.VarChar(40)
  registeredAt DateTime? @default(now())
  active   Boolean?
  credentialVersion Int @default(1)
  bill     bill[]
  salary   salary[]
  sales    sales[]
  openedJornadas    jornada[]  @relation("OpenedJornadas")
  closedJornadas    jornada[]  @relation("ClosedJornadas") 
  savingsMovements savings_movement[]
  collectedDebts    debtors[]  @relation("CollectedDebts")
  collectedSales    sales[]    @relation("CollectedSales")
  cashCounts        cash_count[] @relation("CountOperator")
  receivedHandovers cash_count[] @relation("HandoverReceiver")
}

model installationState {
  id            Int      @id @default(1)
  initializedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model rolePermission {
  id         Int     @id @default(autoincrement())
  role       String  @db.VarChar(40)
  capability String  @db.VarChar(80)
  enabled    Boolean @default(false)

  @@unique([role, capability])
  @@index([role])
}

model terminal {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(80)
  type          TerminalType
  tokenHash     String   @unique @db.VarChar(64)
  active        Boolean  @default(true)
  credentialVersion Int @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sessions      terminalSession[]
  requests      terminalRequest[]
}

model terminalRequest {
  id                String   @id @default(uuid()) @db.Uuid
  browserTokenHash  String   @db.VarChar(64)
  status            TerminalRequestStatus @default(PENDING)
  terminalId        String?  @db.Uuid
  terminal          terminal? @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  expiresAt         DateTime

  @@index([status, expiresAt])
  @@index([browserTokenHash, createdAt])
}

model terminalSession {
  terminalId String   @db.Uuid
  sessionId  String   @db.VarChar(64)
  createdAt  DateTime @default(now())
  terminal   terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  @@id([terminalId, sessionId])
  @@index([sessionId])
}

model securityAudit {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  action     String   @db.VarChar(80)
  subjectId  String?  @db.VarChar(80)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}

model authRateLimit {
  key        String   @id @db.VarChar(160)
  attempts   Int      @default(0)
  windowEnds DateTime
  updatedAt  DateTime @updatedAt
}

model jornada {
  id                    Int            @id @default(autoincrement())
  openedAt              DateTime       @default(now())
  closedAt              DateTime?      
  openedBy              Int
  closedBy              Int?           
  status                JornadaStatus  @default(OPEN)
  openingAmountCents BigInt
  expectedClosingAmountCents BigInt?
  actualClosingAmountCents BigInt?
  // Expected transfers of the shift, saved at close. There is no "actual"
  // counterpart yet because transfers have no physical count.
  expectedTransferAmountCents BigInt?

  openedByUser users  @relation("OpenedJornadas", fields: [openedBy], references: [id])
  closedByUser users? @relation("ClosedJornadas", fields: [closedBy], references: [id])
  savingsMovements savings_movement[]

  sales sales[]
  bills bill[]
  salaries salary[]
  debtsCreated debtors[] @relation("DebtCreatedJornada")
  debtsPaid    debtors[] @relation("DebtPaidJornada")
  paidSales    sales[] @relation("SalePaidJornada")
  cashCounts   cash_count[]

  @@index([status, openedAt])
}

model cash_count {
  id              Int      @id @default(autoincrement())
  jornadaId       Int
  type            CashCountType
  operatorId      Int
  outgoingOperatorName String? @db.VarChar(50)
  incomingOperatorId Int?
  incomingOperatorName String? @db.VarChar(50)
  cutoffAt        DateTime @db.Timestamp(6)
  denominations   Json
  note            String?  @db.VarChar(1000)
  recountOfId     Int?
  requestId       String   @unique @db.Uuid
  payloadHash     String   @db.VarChar(64)
  countedAmountCents BigInt
  expectedAmountCents BigInt
  differenceCents BigInt
  toleranceCents  BigInt
  cashSummary     Json
  jornada         jornada @relation(fields: [jornadaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operator        users   @relation("CountOperator", fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  incomingOperator users? @relation("HandoverReceiver", fields: [incomingOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recountOf       cash_count? @relation("CashCountRecounts", fields: [recountOfId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recounts        cash_count[] @relation("CashCountRecounts")

  @@index([jornadaId, cutoffAt])
  @@index([operatorId, cutoffAt])
  @@index([type, cutoffAt])
}

enum CashCountType {
  OPENING
  INTERIM
  CLOSING
  HANDOVER
}

enum JornadaStatus {
  OPEN
  CLOSED
}

enum SaleStatus {
  UNPAID
  PAID
  DEBT
  CANCELLED
}

enum PaymentMethod {
  TRANSFER
  CASH
}

model savings_movement {
    id            Int                    @id @default(autoincrement())
    amountCents BigInt
    type          SavingsMovementType
    description   String?
    createdAt     DateTime               @default(now())
    registered_by Int
    jornadaId     Int?

    users         users                  @relation(fields: [registered_by], references: [id])
    jornada       jornada?               @relation(fields: [jornadaId], references: [id])

    @@index([jornadaId])
    @@index([createdAt])
}

enum SavingsMovementType {
    DEPOSIT
    WITHDRAW
}

model savings_goal {
    id            Int                    @id @default(autoincrement())
    name          String                 @db.VarChar(80)
    targetAmountCents BigInt
    deadline      DateTime?
    status        GoalStatus             @default(ACTIVE)
    description   String?
    createdAt     DateTime               @default(now())

    contributions goal_contribution[]
}

enum GoalStatus {
    ACTIVE
    COMPLETED
    CANCELLED
}

model goal_contribution {
    id        Int           @id @default(autoincrement())
    goalId    Int
    amountCents BigInt
    note      String?
    createdAt DateTime      @default(now())

    goal      savings_goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)

    @@index([goalId])
}

// Business-wide configuration shared by every device, stored as a simple
// key/value table so new settings can be added without a migration. Values
// that are specific to a single device (e.g. its terminal label) live in the
// browser's localStorage instead, never here.
model setting {
    key       String   @id @db.VarChar(60)
    value     String?
    updatedAt DateTime @default(now()) @updatedAt
}

enum TerminalType {
  FIXED
  MOBILE
}

enum TerminalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}
